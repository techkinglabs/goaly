# Database configuration (example only — do NOT put real secrets here)
# For Docker Compose, the host MUST be the compose service name "postgres",
# NOT "localhost" (localhost inside the backend container is the container itself).
DB_URL=jdbc:postgresql://postgres:5432/weekly_progress_db
# For running the backend directly on the host (outside Docker), use:
# DB_URL=jdbc:postgresql://localhost:5432/weekly_progress_db
DB_USER=your_db_user
DB_PASSWORD=your_strong_db_password

# Optional: Backend server configuration
SERVER_PORT=8080

# Optional: Comma-separated list of allowed CORS origins for the backend
# APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
